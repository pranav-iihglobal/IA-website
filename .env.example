# ============================================================================
# IKSARVA — environment variables
# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit .env.local or real secrets.
# ============================================================================

# --- MongoDB Atlas (free M0 tier) -------------------------------------------
# Atlas → Connect → Drivers → copy the connection string, then replace
# <password> with your database user's password and add the database name.
# Create the cluster in AWS Mumbai (ap-south-1) to keep latency low for India.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/iksarva?retryWrites=true&w=majority"

# --- Admin sign-in (Google) -------------------------------------------------
# Admins sign in with Google. There is no password anywhere in this app.
#
# Google Cloud → APIs & Services → Credentials → OAuth client "iksarva-admin-web".
# The client's Authorised redirect URIs must include BOTH:
#   http://localhost:3000/api/auth/callback/google
#   https://iksarva.com/api/auth/callback/google
GOOGLE_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace_with_the_oauth_client_secret"

# Signs the admin session cookie. Nothing to do with Google — without it,
# an admin session could be forged. Generate with: openssl rand -base64 32
AUTH_SECRET="replace_with_a_long_random_string_at_least_32_chars"

# OPTIONAL second gate, comma separated. Leave unset and access is whoever is
# listed as a test user on the Google OAuth consent screen. Set it to lock the
# panel to specific addresses — required if the OAuth app is ever published,
# because publishing removes the test-user restriction.
# ADMIN_ALLOWED_EMAILS="director.one@gmail.com,director.two@gmail.com"

# --- Cloudinary (free tier) — image hosting ---------------------------------
# Dashboard → Product Environment Credentials.
# The API secret is server-only and must never reach the browser.
CLOUDINARY_CLOUD_NAME="lq6jwnww"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Same cloud name, exposed to the browser for building delivery URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="lq6jwnww"
